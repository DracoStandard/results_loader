<Window x:Class="ResultsLoaderV2.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ResultsLoaderV2"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="dg" HorizontalAlignment="Left" Height="297" Margin="85,0,0,0" VerticalAlignment="Center" Width="403"
                  ItemsSource="{Binding Path=partList}" SelectionChanged="DataGrid_SelectionChanged"
                  
                  />
        <Button x:Name="yes" Content="This One" HorizontalAlignment="Left" Height="51" Margin="596,114,0,0" VerticalAlignment="Top" Width="79" Click="Button_Click"/>
        <Button x:Name="no" Content="None of These" HorizontalAlignment="Left" Height="45" Margin="596,226,0,0" VerticalAlignment="Top" Width="79" Click="no_Click"/>
        <Label x:Name="pn" Content="Label" HorizontalAlignment="Left" Height="49" Margin="71,10,0,0" VerticalAlignment="Top" Width="289"/>

    </Grid>
</Window>
