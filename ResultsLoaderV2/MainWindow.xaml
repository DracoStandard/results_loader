<Window x:Class="ResultsLoaderV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ResultsLoaderV2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Button" HorizontalAlignment="Left" Height="76" Margin="97,279,0,0" VerticalAlignment="Top" Width="84" Click="Button_Click"/>
        <Label x:Name="idOutput" Content="Label" HorizontalAlignment="Left" Height="59" Margin="533,230,0,0" VerticalAlignment="Top" Width="111"/>
        <TextBox x:Name="CompNameTxt" HorizontalAlignment="Left" Height="51" Margin="134,74,0,0" TextWrapping="Wrap" Text="Comp" VerticalAlignment="Top" Width="250"/>
        <TextBox x:Name="SystemTxt" HorizontalAlignment="Left" Height="51" Margin="506,74,0,0" TextWrapping="Wrap" Text="MEG" VerticalAlignment="Top" Width="90"/>
        <Button Content="Button" HorizontalAlignment="Left" Margin="467,289,0,0" VerticalAlignment="Top" Click="Button_Click_1"/>
        <Button Content="Fix Incorrect Army IDs" 
                
                
        HorizontalAlignment="Left" 
        VerticalAlignment="Top" 
        Width="200" 
        Height="30" 
        Click="FixIncorrectArmyIDs_Click"/>

        <Button Content="Update Old Comps"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Width="150"
        Height="30"
        Margin="0,40,0,0"
        Click="UpdateOldComps_Click"/>


        <ToggleButton x:Name="MajorToggleButton"
              Content="Major"
              Width="100"
              Height="30"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="0,80,0,0"
/>

    </Grid>
</Window>
